# AMÁH Brand — backend (Fase 10)
# Copie este arquivo para ".env" e ajuste os valores para o seu ambiente.

# String de conexão do PostgreSQL
DATABASE_URL=postgresql://amah:amah_dev_local_pw@localhost:5432/amah_brand

# Porta em que a API vai escutar
PORT=8787

# Segredo usado para assinar os tokens JWT — troque por um valor aleatório
# longo em produção (ex.: `openssl rand -hex 32`).
JWT_SECRET=troque-este-valor-em-producao

# Credenciais do usuário administrador criado automaticamente pelo `npm run seed`
# Dica: coloque a senha entre aspas se ela contiver "#" ou espaços — o
# dotenv trata "#" fora de aspas como início de comentário e corta o valor.
ADMIN_EMAIL=admin@amahbrand.com.br
ADMIN_PASSWORD="troque-esta-senha"
ADMIN_NAME=Administrador AMÁH Brand

# Origens permitidas para CORS (separadas por vírgula). Use "*" em
# desenvolvimento; em produção, liste os domínios reais da Vitrine e do
# sistema de gestão.
CORS_ORIGINS=*
